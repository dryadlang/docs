<!DOCTYPE html>
<html xmlns="http://www.w3.org/1999/xhtml" lang="$lang$" xml:lang="$lang$"$if(dir)$ dir="$dir$"$endif$>
<head>
  <meta charset="utf-8" />
  <meta name="generator" content="pandoc" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0, user-scalable=yes" />
$for(author-meta)$
  <meta name="author" content="$author-meta$" />
$endfor$
$if(date-meta)$
  <meta name="dcterms.date" content="$date-meta$" />
$endif$
$if(keywords)$
  <meta name="keywords" content="$for(keywords)$$keywords$$sep$, $endfor$" />
$endif$
$if(description-meta)$
  <meta name="description" content="$description-meta$" />
$endif$
  <title>$if(title-prefix)$$title-prefix$ – $endif$$pagetitle$</title>
  <style>
    $styles.html()$
  </style>
$for(css)$
  <link rel="stylesheet" href="$css$" />
$endfor$
$for(header-includes)$
  $header-includes$
$endfor$
$if(math)$
  $math$
$endif$
</head>
<body>
<div class="spec-layout">
  <aside class="spec-sidebar">
    <a class="spec-brand" href="#title-block-header">
      <img src="assets/dryad-logo.png" alt="Dryad logo" />
      <span>Dryad<br />Specification</span>
    </a>
$if(toc)$
    <nav id="$idprefix$TOC" role="doc-toc">
$if(toc-title)$
      <h2 id="$idprefix$toc-title">$toc-title$</h2>
$else$
      <h2>Contents</h2>
$endif$
$table-of-contents$
    </nav>
$endif$
    <div class="spec-sidebar-footer">
      Edition 1.0 &middot; Draft<br />
      <a href="dryad-specification.pdf">PDF edition</a> &middot;
      <a href="https://github.com/dryadlang/docs">Source</a>
    </div>
  </aside>
  <main class="spec-main">
$for(include-before)$
$include-before$
$endfor$
$if(title)$
    <header id="title-block-header" class="spec-cover">
      <div class="kicker">Dryad Language Project &middot; Normative Specification</div>
      <h1 class="title">$title$</h1>
$if(subtitle)$
      <p class="subtitle">$subtitle$</p>
$endif$
      <div class="meta">
        <strong>Edition:</strong> 1.0 (Draft) &middot;
        <strong>Status:</strong> Draft Standard<br />
$for(author)$
        <strong>Editor:</strong> $author$ &middot;
$endfor$
        <strong>Date:</strong> $date$
      </div>
$if(abstract)$
      <div class="spec-abstract">
        <span class="label">Abstract</span>
$abstract$
      </div>
$endif$
    </header>
$endif$
$body$
    <footer class="spec-footer">
      <p><strong>Dryad Language Specification, Edition 1.0 (Draft).</strong>
      This document defines the normative behaviour of the Dryad programming
      language. Clauses are normative unless explicitly marked otherwise.
      Proposals and implementation guidance are confined to the informative
      annexes.</p>
      <p>Published by the Dryad Language Project &middot; Licensed under the MIT
      License &middot; <a href="dryad-specification.pdf">PDF edition</a> &middot;
      <a href="https://github.com/dryadlang/docs">Repository</a></p>
    </footer>
  </main>
</div>
$for(include-after)$
$include-after$
$endfor$
</body>
</html>
